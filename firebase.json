{
  "functions": [{ "source": "functions", "codebase": "protected-proofs", "runtime": "nodejs22", "predeploy":["node scripts/deploy-guard.cjs"] }],
  "firestore": [{"database":"protected-deliveries","rules":"firestore.rules"}],
  "hosting": {
    "target":"protected-app",
    "public":"dist",
    "predeploy":["node scripts/deploy-guard.cjs","node scripts/build.cjs"],
    "ignore":["**/.*"],
    "headers":[{"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Cache-Control","value":"no-cache"}]}]
  }
}
