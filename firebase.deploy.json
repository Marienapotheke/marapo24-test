{
  "functions": [{"source":"functions","codebase":"protected-proofs","runtime":"nodejs22"}],
  "firestore": [{"database":"protected-deliveries","rules":"firestore.rules"}],
  "hosting": {
    "target":"protected-app",
    "public":"dist",
    "ignore":["**/.*"],
    "headers":[
      {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Cache-Control","value":"no-cache"}]}
    ]
  }
}
